{
    "name": "webmunkeez/context-bundle",
    "type": "symfony-bundle",
    "description": "Context storage for Symfony, backed by cookies.",
    "keywords": [
        "symfony",
        "context",
        "cookie",
        "autowiring"
    ],
    "homepage": "https://github.com/yannissgarra/context-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Yannis Sgarra",
            "email": "hello@yannissgarra.com",
            "homepage": "https://yannissgarra.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^7.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/property-access": "^7.4",
        "symfony/property-info": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/string": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-symfony": "^2",
        "phpstan/phpstan-deprecation-rules": "^2",
        "phpunit/phpunit": "^11",
        "symfony/framework-bundle": "^7.4",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Webmunkeez\\ContextBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webmunkeez\\ContextBundle\\Test\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
